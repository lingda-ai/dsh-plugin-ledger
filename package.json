{
  "name": "@lingda-ai/ledger",
  "version": "0.1.15",
  "license": "Apache-2.0",
  "type": "module",
  "description": "DSH 运行时账本：旁路计量 Agent 的 token 与成本，并据预算对下一次请求做决策",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ledger",
    "cost",
    "token-usage"
  ],
  "author": "LingDaAi",
  "homepage": "https://gitee.com/linzhengtong/dsh-plugin-ledger",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/linzhengtong/dsh-plugin-ledger.git"
  },
  "bugs": {
    "url": "https://gitee.com/linzhengtong/dsh-plugin-ledger/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/technical.md",
    "docs/wire-format.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "node scripts/build-client.mjs && node --test test/*.test.mjs",
    "bench": "node --expose-gc scripts/bench.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
